{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fintech-contact-v1",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker owns permanent redirects; avoid Assets emitting 307 HTML aliases.
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "fintech.contact", "custom_domain": true },
    { "pattern": "www.fintech.contact", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
