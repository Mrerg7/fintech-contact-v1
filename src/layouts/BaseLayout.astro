---
import '../styles/global.css';
import { SITE, OG_IMAGE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  faqs?: { question: string; answer: string }[];
  processSteps?: { title: string; body: string }[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
  faqs = [],
  processSteps = [],
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
// Always emit the apex HTTPS URL with trailing slash — never the request host.
const canonicalURL = new URL(pathname, `${SITE.url}/`).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: canonicalURL,
    name: SITE.name,
    description,
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: canonicalURL,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    datePublished: SITE.publishedDate,
    dateModified: SITE.modifiedDate,
    inLanguage: 'en-US',
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImage,
      width: 1024,
      height: 558,
    },
  },
  {
    '@type': 'Product',
    '@id': `${SITE.url}/#product`,
    name: 'fintech.contact Premium Domain Name',
    description:
      'The definitive premium .contact domain for financial technologies. Category-defining brand asset available for acquisition.',
    url: canonicalURL,
    image: ogImage,
    category: 'Premium Domain Name',
    brand: {
      '@type': 'Brand',
      name: SITE.name,
    },
    offers: {
      '@type': 'Offer',
      url: canonicalURL,
      price: String(SITE.askingPrice),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      businessFunction: 'https://schema.org/Sell',
      itemCondition: 'https://schema.org/NewCondition',
      seller: {
        '@type': 'Organization',
        name: SITE.name,
        email: SITE.email,
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: {
          '@type': 'MonetaryAmount',
          value: '0.00',
          currency: 'USD',
        },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: {
            '@type': 'QuantitativeValue',
            minValue: 0,
            maxValue: 1,
            unitCode: 'DAY',
          },
          transitTime: {
            '@type': 'QuantitativeValue',
            minValue: 0,
            maxValue: 0,
            unitCode: 'DAY',
          },
        },
        shippingDestination: {
          '@type': 'DefinedRegion',
          addressCountry: 'US',
        },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
        applicableCountry: 'US',
        merchantReturnDays: 0,
      },
    },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
    email: SITE.email,
    description:
      'Owner-operated listing for the premium domain fintech.contact, available for acquisition.',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: SITE.email,
      availableLanguage: ['en'],
    },
  },
];

if (processSteps.length > 0) {
  graph.push({
    '@type': 'HowTo',
    '@id': `${SITE.url}/#how-to-acquire`,
    name: 'How to acquire the fintech.contact domain',
    description:
      'Three-step process to purchase fintech.contact: inquiry, escrow, and registrar transfer.',
    url: `${canonicalURL}#process`,
    inLanguage: 'en-US',
    step: processSteps.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.title,
      text: step.body,
    })),
  });
}

if (faqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    url: `${canonicalURL}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};

const keywords = [
  'fintech.contact',
  'fintech domain for sale',
  'financial technologies domain',
  'premium fintech domain',
  'buy fintech domain',
  'payments domain for sale',
  'neobank domain',
  '.contact domain for sale',
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c1b2a" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" href={canonicalURL} hreflang="en" />
    <link rel="alternate" href={canonicalURL} hreflang="x-default" />

    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="558" />
    <meta
      property="og:image:alt"
      content="fintech.contact — The definitive domain for Financial Technologies"
    />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="fintech.contact — The definitive domain for Financial Technologies"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Sora:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="atmosphere min-h-dvh overflow-x-hidden antialiased">
    <slot />
  </body>
</html>
