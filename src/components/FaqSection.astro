---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="relative z-10 scroll-mt-20 px-5 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">
        FAQ
      </p>
      <h2 class="section-title text-[var(--color-ink)]">
        Questions before you inquire.
      </h2>
      <p class="mt-4 font-serif text-lg leading-relaxed text-[var(--color-ink-soft)]/80">
        Straight answers on price, process, and ownership — so you can move quickly when you are ready.
      </p>
    </div>

    <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {faqs.map((faq) => (
        <article class="border-t border-[var(--color-line)] pt-6">
          <h3 class="font-display text-lg tracking-tight text-[var(--color-ink)] sm:text-xl">
            {faq.question}
          </h3>
          <p class="mt-3 max-w-prose text-[0.98rem] leading-relaxed text-[var(--color-ink-soft)]/75">
            {faq.answer}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
